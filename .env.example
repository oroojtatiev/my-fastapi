# Database
# Host is the docker compose service name (db).
# For local dev without Docker set it to localhost.
DATABASE_URL=postgresql+psycopg://postgres:mysecretpassword@db:5432/mydatabase

# Postgres (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=mydatabase

# App
FRONTEND_URL=http://localhost:8000

# Auth
# Must be at least 32 bytes for HS256; generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=change-me-in-production-32-bytes-min
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Media
MEDIA_PROFILE_PICS_DIR=media/profile_pics
MEDIA_DEFAULT_PROFILE_PIC=media/profile_pics/default.jpeg
MEDIA_MAX_UPLOAD_SIZE_BYTES=5242880

# Mail
MAIL_RESET_TOKEN_EXPIRE_MINUTES=60
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_USE_TLS=True